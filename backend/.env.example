# Flask Server Configuration
FLASK_ENV=development
DEBUG=True
PORT=5000

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gmail SMTP Integration (for task created / completed email notifications)
# Generate App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM_NAME=Hairdrama Tasks

# Frontend Client URL (for CORS and links inside notification emails)
FRONTEND_URL=http://localhost:3000
