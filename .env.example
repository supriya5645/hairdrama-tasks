# ==============================================================================
# Hairdrama Tech - Task Management System Environment Variables
# Copy this file to backend/.env and frontend/.env.local and populate the values.
# ==============================================================================

# --- SUPABASE CONFIGURATION ---
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- FLASK BACKEND CONFIGURATION ---
FLASK_ENV=development
DEBUG=True
PORT=5000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- GMAIL SMTP INTEGRATION ---
# 1. Enable 2-Step Verification on your Google account.
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and 16-character App Password below.
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM_NAME=Hairdrama Tasks
